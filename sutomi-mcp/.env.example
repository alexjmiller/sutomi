# sutomi-mcp (dev). In production these come from /data/sutomi/.env via docker-compose.yml.
PORT=3037
SUTOMI_URL=http://localhost:3000
SUTOMI_TOKEN=            # = SUTOMI_API_TOKEN on the sutomi server
MCP_TOKEN=               # bearer for POST /mcp (MCP clients)
VOICE_TOKEN=             # bearer for POST /voice (the Shortcut)
# ALLOWED_HOSTS=localhost,127.0.0.1   # Host header check on /mcp (sutomi.net in production)
